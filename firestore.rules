rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 100));
    }

    function isValidJournalEntry(data) {
      return data.keys().hasAll(['id', 'userId', 'role', 'text', 'createdAt', 'timestamp']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.role is string && (data.role == 'user' || data.role == 'model') &&
        data.text is string && data.text.size() <= 20000 &&
        data.createdAt is string && data.createdAt.size() <= 100 &&
        data.timestamp is number &&
        (!('topic' in data) || (data.topic is string && data.topic.size() <= 200));
    }

    function isValidSummary(data) {
      return data.keys().hasAll(['id', 'userId', 'learningSummary', 'conceptToRevise', 'nextAction', 'createdAt', 'timestamp']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.learningSummary is string && data.learningSummary.size() <= 20000 &&
        data.conceptToRevise is string && data.conceptToRevise.size() <= 10000 &&
        data.nextAction is string && data.nextAction.size() <= 10000 &&
        data.createdAt is string && data.createdAt.size() <= 100 &&
        data.timestamp is number &&
        (!('topic' in data) || (data.topic is string && data.topic.size() <= 200));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if false;

      match /entries/{entryId} {
        allow get: if isOwner(userId) && isValidId(entryId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(entryId) && isValidJournalEntry(incoming()) && incoming().userId == userId;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(entryId);
      }

      match /summaries/{summaryId} {
        allow get: if isOwner(userId) && isValidId(summaryId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(summaryId) && isValidSummary(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(summaryId) && isValidSummary(incoming()) && incoming().userId == userId;
        allow delete: if isOwner(userId) && isValidId(summaryId);
      }
    }
  }
}
